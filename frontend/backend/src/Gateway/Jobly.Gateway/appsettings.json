
{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Yarp": "Information" } },
  "AllowedHosts": "*",
  "Cors": { "Origins": [ "http://localhost:5173" ] },
  "ReverseProxy": {
    "Routes": {
      "identity": { "ClusterId": "identity", "Match": { "Path": "/api/identity/{**catch-all}" } },
      "companies": { "ClusterId": "companies", "Match": { "Path": "/api/companies/{**catch-all}" } },
      "jobs": { "ClusterId": "jobs", "Match": { "Path": "/api/jobs/{**catch-all}" } },
      "reviews": { "ClusterId": "reviews", "Match": { "Path": "/api/reviews/{**catch-all}" } },
      "salaries": { "ClusterId": "salaries", "Match": { "Path": "/api/salaries/{**catch-all}" } }
    },
    "Clusters": {
      "identity": { "Destinations": { "d1": { "Address": "http://identity:8080" } } },
      "companies": { "Destinations": { "d1": { "Address": "http://companies:8080" } } },
      "jobs": { "Destinations": { "d1": { "Address": "http://jobs:8080" } } },
      "reviews": { "Destinations": { "d1": { "Address": "http://reviews:8080" } } },
      "salaries": { "Destinations": { "d1": { "Address": "http://salaries:8080" } } }
    }
  }
}
